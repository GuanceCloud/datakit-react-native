{
  "name": "@cloudcare/mobile-react-native-navigation",
  "version": "0.4.3-alpha.3",
  "description": "Automatic Guance RUM View tracking for react-native-navigation.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "README.md",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "lint": "yarn run -T eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "prepare": "yarn run -T bob build",
    "prepack": "yarn run -T check-version && yarn prepare",
    "test": "yarn run -T jest",
    "typescript": "yarn run -T tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuanceCloud/datakit-react-native.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@cloudcare/react-native-mobile": "^0.4.3-alpha.3",
    "react": ">=16.13.1",
    "react-native": ">=0.63.4 <1.0",
    "react-native-navigation": "^7.5.0"
  },
  "devDependencies": {
    "react-native-navigation": "7.40.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "tsc": "../../node_modules/.bin/tsc",
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  }
}
